{
  "headers": [
    {
      "source": "/*",
      "headers": [
        {
          "key": "content-security-policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'"
        },
        {
          "key": "x-content-type-options",
          "value": "nosniff"
        },
        {
          "key": "x-frame-options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "referrer-policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "permissions-policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "strict-transport-security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/*.mjs",
      "headers": [
        {
          "key": "content-type",
          "value": "text/javascript;charset=utf-8"
        }
      ]
    },
    {
      "source": "/*.wasm",
      "headers": [
        {
          "key": "content-type",
          "value": "application/wasm"
        }
      ]
    }
  ]
}
